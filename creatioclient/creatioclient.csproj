<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>.NET client to call Creatio API in simple way (.NET Standard compatible)</Description>
    <Authors>Advance Technologies Foundation</Authors>
    <Company>ATF</Company>
    <PackageId>creatio.client</PackageId>
    <Product>creatio.client</Product>
    <AssemblyName>Creatio.Client</AssemblyName>
    <RootNamespace>Creatio.Client</RootNamespace>
    <RepositoryUrl>https://github.com/Advance-Technologies-Foundation/creatioclient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Advance-Technologies-Foundation/creatioclient</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>creatio;api;client;netstandard;bpm;crm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Version is supplied by the release workflow from the git tag (e.g. v1.0.34 -> 1.0.34).
         Local dev builds default to 1.0.0; release notes are managed via GitHub Releases. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
